{
  "uid": "housefull",
  "title": "Housefull",
  "description": "Live metrics from the Housefull booking platform.",
  "tags": [
    "housefull"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Requests per second",
      "type": "timeseries",
      "datasource": {
        "type": "stackdriver",
        "uid": "housefull-monitoring"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "housefull-monitoring"
          },
          "queryType": "timeSeriesList",
          "aliasBy": "{{metric.label.response_code_class}}",
          "timeSeriesList": {
            "projectName": "__PROJECT__",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/request_count",
              "AND",
              "resource.type",
              "=",
              "cloud_run_revision",
              "AND",
              "resource.label.service_name",
              "=",
              "housefull-api"
            ],
            "groupBys": [
              "metric.label.response_code_class"
            ],
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_RATE",
            "alignmentPeriod": "+60s",
            "view": "FULL"
          }
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
